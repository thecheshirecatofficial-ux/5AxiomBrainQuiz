<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The 5 Axiom Brain Quiz</title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            --card-bg: rgba(30, 41, 59, 0.8);
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .quiz-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px;
            max-width: 650px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            text-align: center;
        }

        .progress-bar-container {
            width: 100%;
            height: 8px;
            background-color: var(--border);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 30px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background-color: var(--accent);
            transition: width 0.3s ease;
        }

        .question-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 24px;
            line-height: 1.4;
        }

        .options-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 16px 20px;
            border-radius: 12px;
            font-size: 1rem;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s ease;
        }

        .option-btn:hover {
            background: var(--accent);
            border-color: var(--accent-hover);
            transform: translateY(-2px);
        }

        .results-container {
            display: none;
        }

        .results-title {
            font-size: 2rem;
            color: #38bdf8;
            margin-bottom: 12px;
        }

        .results-body {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .restart-btn {
            background-color: var(--accent);
            color: var(--text);
            border: none;
            padding: 14px 28px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .restart-btn:hover {
            background-color: var(--accent-hover);
        }
    </style>
</head>
<body>

<div class="quiz-card">
    <div id="quiz-view">
        <div class="progress-bar-container">
            <div class="progress-bar" id="progress"></div>
        </div>
        <h2 class="question-title" id="question">Loading Question...</h2>
        <div class="options-grid" id="options"></div>
    </div>

    <div class="results-container" id="results-view">
        <h2 class="results-title">Quiz Complete!</h2>
        <p class="results-body" id="results-text">Your brain profile has been evaluated based on the 5 Axioms.</p>
        <button class="restart-btn" onclick="restartQuiz()">Take Quiz Again</button>
    </div>
</div>

<script>
    // Replace the text below with your exact questions and choices from Canva
    const quizData = [
        {
            question: "Axiom 1: Processing Focus",
            subtitle: "Which statement best describes your baseline cognitive focus?",
            answers: [
                "I analyze logical structures and breaking down systems.",
                "I process through visual patterns and holistic intuition.",
                "I focus on practical execution and immediate trial-and-error."
            ]
        },
        {
            question: "Axiom 2: Problem Solving",
            subtitle: "How do you navigate high-complexity problems?",
            answers: [
                "Deconstruct the problem into granular step-by-step components.",
                "Step back to visualize the full big-picture map.",
                "Experiment directly to observe real-world feedback."
            ]
        },
        {
            question: "Axiom 3: Information Absorption",
            subtitle: "What medium allows you to learn new concepts fastest?",
            answers: [
                "Detailed written documentation and technical specs.",
                "Visual diagrams, flowcharts, and mind maps.",
                "Interactive walk-throughs and hands-on practice."
            ]
        },
        {
            question: "Axiom 4: Decision Making",
            subtitle: "What drives your final conclusions when under pressure?",
            answers: [
                "Objective data and empirical evidence.",
                "Gut instinct and contextual awareness.",
                "Historical results and proven precedent."
            ]
        },
        {
            question: "Axiom 5: Adaptability",
            subtitle: "How do you react when initial plans fail?",
            answers: [
                "Re-evaluate the core assumptions and adjust the logic.",
                "Pivot quickly to a creative alternative strategy.",
                "Double down on practical iteration until it works."
            ]
        }
    ];

    let currentStep = 0;

    function renderQuestion() {
        const quizView = document.getElementById("quiz-view");
        const resultsView = document.getElementById("results-view");

        if (currentStep >= quizData.length) {
            quizView.style.display = "none";
            resultsView.style.display = "block";
            return;
        }

        quizView.style.display = "block";
        resultsView.style.display = "none";

        const item = quizData[currentStep];
        document.getElementById("question").innerText = `${item.question}\n${item.subtitle || ''}`;
        
        // Update Progress Bar
        const progressPct = ((currentStep) / quizData.length) * 100;
        document.getElementById("progress").style.width = `${progressPct}%`;

        // Render Answer Options
        const optionsContainer = document.getElementById("options");
        optionsContainer.innerHTML = "";
        
        item.answers.forEach(answer => {
            const btn = document.createElement("button");
            btn.className = "option-btn";
            btn.innerText = answer;
            btn.onclick = () => {
                currentStep++;
                renderQuestion();
            };
            optionsContainer.appendChild(btn);
        });
    }

    function restartQuiz() {
        currentStep = 0;
        renderQuestion();
    }

    // Initialize Quiz
    renderQuestion();
</script>

</body>
</html>
